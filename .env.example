# EcoLogix AI - Environment Configuration Template
HOST=0.0.0.0
PORT=3000
ECOLOGIX_SECRET_KEY=replace-with-strong-random-secret
# Set to true in strict production to require login before accessing workspace APIs
ECOLOGIX_STRICT_AUTH=false
# Comma-separated frontend origins allowed via CORS (e.g. https://ecologix-ai.vercel.app)
ECOLOGIX_CORS_ORIGINS=*
# Consultation / FAQ contact destination email
ECOLOGIX_CONTACT_EMAIL=geroolyhuicy@gmail.com
# Optional real SMTP delivery (e.g. Gmail SMTP + 16-char App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional custom SQLite path (e.g. /var/data/ecologix.db with Render Persistent Disk)
# ECOLOGIX_DB_PATH=
# TiDB Cloud Serverless (MySQL-compatible, overrides default local SQLite when TIDB_HOST is set)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=ecologix
# Optional custom TLS CA file path (auto-uses certifi bundle by default)
# TIDB_SSL_CA=

